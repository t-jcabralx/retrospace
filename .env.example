# Copy to .env.local and fill in. NEVER commit real values.
# Placeholder values below are commented out on purpose: copying this file as-is must not give you a "configured" app
# with fake credentials. Uncomment a line only when you have the real value.
# Without MONGODB_URI the app uses an in-memory store (data is lost on restart).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# MONGODB_DB=retrospace

# Live sync, presence and rate limits (without these the board polls every few seconds and limits are per process)
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# Signs board membership tokens, passcode access cookies, guest cookies and every participant's board id.
# REQUIRED in production: the app refuses to sign anything without it (no fallback to the Upstash token there). Optional in
# development. Use a long random value, e.g. `openssl rand -hex 32`.
# Treat it as permanent: changing it orphans every stored identity (guests become new people, owners are asked to choose a
# persona again, names they used are taken by their old selves) and signs everyone out of passcode boards.
RT_SECRET=

# Optional: longest one realtime (SSE) connection lives, in ms (default 270000 = 4.5 minutes, below Vercel's 300 s limit).
# On reconnect board access is checked again, so this is also how quickly a revoked or re-passcoded guest loses an open stream.
# RT_STREAM_MAX_MS=270000

# Optional: GIF search via the Giphy React SDK (public web SDK key; without it, paste a GIF URL)
# NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: public address of your site. Only used for page metadata (metadataBase / Open Graph); share links are built
# from the address the page is opened at.
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: AI-written summary drafts (server-side only, never exposed to the browser). Uses the smallest model.
# ANTHROPIC_API_KEY=
# AI_SUMMARY_MODEL=claude-haiku-5-5
# Global cap on AI summaries per day across all boards and owners (default 300). Also set a monthly spend limit in the
# Anthropic console: the cap bounds requests, the console limit bounds money.
# AI_DAILY_CAP=300
# Development only: AI_FAKE=1 returns a canned summary instead of calling the API (ignored in production).
# AI_FAKE=1
